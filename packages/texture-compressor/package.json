{
  "name": "texture-compressor",
  "version": "0.1.0",
  "description": "TypeScript/WebWorker wrapper for ETC2 and DXT5 texture compression",
  "license": "MIT",
  "main": "../../lib/texture-compressor.js",
  "module": "../../lib/texture-compressor.js",
  "types": "../../lib/texture-compressor.d.ts",
  "exports": {
    ".": {
      "import": "../../lib/texture-compressor.js",
      "types": "../../lib/texture-compressor.d.ts"
    },
    "./worker": {
      "import": "../../lib/texture-compressor.worker.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "rollup": "^4.34.0",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.0",
    "typescript": "~5.7.0"
  },
  "sideEffects": false
}
