{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@manticore/project": ["../../packages/project/src/index.ts"],
      "@manticore/project/types": ["../../packages/project/src/types.ts"],
      "@manticore/project/constants": ["../../packages/project/src/constants.ts"],
      "image-polygonizer": ["../../packages/image-polygonizer/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "rollup.config.mjs"],
  "exclude": ["src/**/__tests__/**"]
}
