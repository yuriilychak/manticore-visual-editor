{
  "name": "@manticore/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,main,electron -c cyan,magenta,green \"vite --host 127.0.0.1\" \"rollup --config rollup.config.mjs --watch\" \"wait-on tcp:5173 file:dist/main.cjs && electronmon dist/main.cjs\"",
    "build": "vite build && rollup --config rollup.config.mjs",
    "check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electronmon": "^2.0.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.48.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.3"
  }
}

